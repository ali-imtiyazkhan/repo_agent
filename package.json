{
  "name": "repo-agent",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "eval": "turbo run eval",
    "eval:single": "pnpm --filter @repo-agent/evals eval:single",
    "typecheck": "turbo run typecheck",
    "agent": "pnpm --filter @repo-agent/agent dev",
    "agent:run": "pnpm --filter @repo-agent/agent dev run"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prettier": "^3.7.4",
    "tsx": "^4.22.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "zod": "^4.4.3"
  }
}