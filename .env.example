# Google Gemini API Configuration
# Get your API key at: https://aistudio.google.com/apikey

# Required: Your Google Gemini API key
GEMINI_API_KEY=

# Optional: Gemini model to use (defaults to gemini-2.0-flash).
# Avoid gemini-flash-latest — it may resolve to a new model with very low free tier quotas.
# gemini-2.0-flash has 1500 req/day free tier.
GEMINI_MODEL=gemini-2.0-flash

# Optional: Gemini API base URL (defaults to OpenAI-compatible endpoint)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/